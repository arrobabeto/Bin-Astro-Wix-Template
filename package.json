{
  "name": "bawt",
  "displayName": "Bin Astro and Wix Template",
  "version": "0.1.0",
  "description": "Template de Astro en hosting de Wix. Stack y estructura, sin sitio de ejemplo.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "wix dev",
    "build": "wix build",
    "preview": "wix preview",
    "release": "wix release",
    "setup": "node scripts/setup.mjs",
    "demo:clear": "node scripts/demo-clear.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "sh -c 'WIX_CLIENT_ID=\"${WIX_CLIENT_ID-}\" astro check'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check:node": "node scripts/check-node.mjs",
    "check:leakage": "node scripts/check-key-leakage.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "check:docs": "node scripts/check-doc-references.mjs",
    "check:skills": "node scripts/check-skills.mjs",
    "check:no-localhost": "node scripts/check-no-localhost.mjs",
    "check:google-fonts": "node scripts/check-google-fonts.mjs",
    "check:parallel-catalog": "node scripts/check-parallel-catalog.mjs",
    "check:assets": "node scripts/check-asset-budget.mjs",
    "check:source": "npm run check:node && npm run check:placeholders && npm run check:docs && npm run check:skills && npm run check:no-localhost && npm run check:google-fonts && npm run check:parallel-catalog && npm run check:assets && npm run check:leakage",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run check:source && npm run test"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,astro,json,md,css,yml}": "prettier --write",
    "*.{js,mjs,cjs,ts,tsx,astro}": "eslint --max-warnings=0 --no-warn-ignored"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@wix/astro": "^3.0.1",
    "@wix/astro-pages": "^3.0.1",
    "@wix/astro-wix-hosting-adapter": "^3.0.2",
    "@wix/essentials": "^1.0.15",
    "@wix/sdk": "^1.21.5",
    "astro": "^7.3.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "^4.1.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/react": "^6.0.6",
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@wix/cli": "^1.1.92",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.10.0",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
