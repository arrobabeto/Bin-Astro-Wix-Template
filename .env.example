# `wix env pull` writes this into .env.local. This file is committed.
# .env.local is not committed. Do not paste secrets here.

WIX_CLOUD_PROVIDER=
WIX_CLIENT_ID=
WIX_CLIENT_INSTANCE_ID=
WIX_CLIENT_PUBLIC_KEY=
WIX_CLIENT_SECRET=

# WIX_API_KEY does not belong in this file or in .env.local.
# It lives in the client repository's GitHub Secrets.
# It is not the site OAuth secret.
