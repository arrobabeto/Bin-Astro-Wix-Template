# Lo escribe `wix env pull` en .env.local. Este archivo sí se commitea.
# .env.local no se commitea. No pegues secretos aquí.

WIX_CLOUD_PROVIDER=
WIX_CLIENT_ID=
WIX_CLIENT_INSTANCE_ID=
WIX_CLIENT_PUBLIC_KEY=
WIX_CLIENT_SECRET=

# WIX_API_KEY no vive en este archivo ni en .env.local.
# Vive en GitHub Secrets del repositorio del cliente.
# No es el secreto OAuth del sitio.
