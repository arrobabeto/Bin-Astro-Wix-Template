---
import BaseLayout from "../layouts/BaseLayout.astro"
import { site } from "../config/site"
---

<BaseLayout title={site.name} description={site.description}>
  <!-- bawt:demo -->
  <main class="mx-auto max-w-3xl px-6 py-16">
    <p class="text-sm text-accent">BAWT</p>
    <h1 class="mt-3 text-4xl font-semibold">{site.name}</h1>
    <p class="mt-4 max-w-xl text-lg">{site.description}</p>
    <p class="mt-8 text-sm">
      Marcador de arranque. Se quita con <code>npm run demo:clear</code> al
      empezar el diseño.
    </p>
  </main>
</BaseLayout>
