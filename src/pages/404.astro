---
import BaseLayout from "../layouts/BaseLayout.astro"
---

<BaseLayout
  title="Página no encontrada"
  description="Esta dirección no corresponde a una página de este sitio."
>
  <main class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="text-4xl font-semibold">Página no encontrada</h1>
    <p class="mt-4">
      Esta dirección no corresponde a una página de este sitio.
    </p>
    <a class="mt-8 inline-block text-accent underline" href="/">
      Volver al inicio
    </a>
  </main>
</BaseLayout>
